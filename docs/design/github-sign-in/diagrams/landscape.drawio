<mxfile host="drawio">
  <diagram id="landscape" name="Sign-in landscape">
    <mxGraphModel dx="900" dy="460" grid="0" gridSize="10" page="0" pageWidth="900" pageHeight="460">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lane-browser" value="User's browser" vertex="1" parent="1" style="html=0;verticalAlign=top;fillColor=#161b22;strokeColor=#344052;fontColor=#a9b6c6;dashed=1;">
          <mxGeometry x="20" y="20" width="220" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="lane-cloudflare" value="Cloudflare: mardoc.app zone" vertex="1" parent="1" style="html=0;verticalAlign=top;fillColor=#161b22;strokeColor=#344052;fontColor=#a9b6c6;dashed=1;">
          <mxGeometry x="280" y="20" width="240" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="lane-pages" value="GitHub Pages" vertex="1" parent="1" style="html=0;verticalAlign=top;fillColor=#161b22;strokeColor=#344052;fontColor=#a9b6c6;dashed=1;">
          <mxGeometry x="560" y="20" width="310" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="lane-github" value="GitHub" vertex="1" parent="1" style="html=0;verticalAlign=top;fillColor=#161b22;strokeColor=#344052;fontColor=#a9b6c6;dashed=1;">
          <mxGeometry x="560" y="180" width="310" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="MarDoc app&#xa;(exists; sign-in to build)" vertex="1" parent="1" style="rounded=0;html=0;fillColor=#1f2733;strokeColor=#4fd1ec;fontColor=#e6edf3;">
          <mxGeometry x="40" y="80" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="proxy" value="Cloudflare proxy&#xa;(exists)" vertex="1" parent="1" style="rounded=0;html=0;fillColor=#1f2733;strokeColor=#4fd1ec;fontColor=#e6edf3;">
          <mxGeometry x="300" y="80" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="Auth Worker&#xa;/api/auth/*&#xa;(proposed)" vertex="1" parent="1" style="rounded=0;html=0;dashed=1;fillColor=#1f2733;strokeColor=#4fd1ec;fontColor=#e6edf3;">
          <mxGeometry x="300" y="230" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="pages" value="Static site out/&#xa;(exists)" vertex="1" parent="1" style="rounded=0;html=0;fillColor=#1f2733;strokeColor=#a9b6c6;fontColor=#e6edf3;">
          <mxGeometry x="620" y="65" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="oauth" value="GitHub App&#xa;sign-in" vertex="1" parent="1" style="rounded=0;html=0;dashed=1;fillColor=#1f2733;strokeColor=#a9b6c6;fontColor=#e6edf3;">
          <mxGeometry x="580" y="240" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="GitHub API&#xa;(exists)" vertex="1" parent="1" style="rounded=0;html=0;fillColor=#1f2733;strokeColor=#a9b6c6;fontColor=#e6edf3;">
          <mxGeometry x="730" y="240" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="app-proxy" value="mardoc.app/*" edge="1" parent="1" source="app" target="proxy" style="html=0;strokeColor=#a9b6c6;fontColor=#e6edf3;labelBackgroundColor=#161b22;endArrow=block;endFill=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="proxy-pages" value="all other paths" edge="1" parent="1" source="proxy" target="pages" style="html=0;strokeColor=#a9b6c6;fontColor=#e6edf3;labelBackgroundColor=#161b22;endArrow=block;endFill=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="proxy-worker" value="/api/auth/*" edge="1" parent="1" source="proxy" target="worker" style="html=0;strokeColor=#a9b6c6;fontColor=#e6edf3;labelBackgroundColor=#161b22;endArrow=block;endFill=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="worker-oauth" value="code to token&#xa;(client secret)" edge="1" parent="1" source="worker" target="oauth" style="html=0;strokeColor=#a9b6c6;fontColor=#e6edf3;labelBackgroundColor=#161b22;endArrow=block;endFill=1;exitX=1;exitY=0.25;entryX=0;entryY=0.25;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="app-oauth" value="sign in and consent" edge="1" parent="1" source="app" target="oauth" style="html=0;strokeColor=#a9b6c6;fontColor=#e6edf3;labelBackgroundColor=#161b22;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.3;exitY=1;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="94" y="375"/><mxPoint x="645" y="375"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="app-api" value="documents and reviews (access token)" edge="1" parent="1" source="app" target="api" style="html=0;strokeColor=#a9b6c6;fontColor=#e6edf3;labelBackgroundColor=#161b22;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.7;exitY=1;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="166" y="415"/><mxPoint x="790" y="415"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="oauth-worker" value="redirect with code" edge="1" parent="1" source="oauth" target="worker" style="html=0;strokeColor=#a9b6c6;fontColor=#e6edf3;labelBackgroundColor=#161b22;endArrow=block;endFill=1;exitX=0;exitY=0.8;entryX=1;entryY=0.8;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="worker-app" value="access token" edge="1" parent="1" source="worker" target="app" style="html=0;strokeColor=#a9b6c6;fontColor=#e6edf3;labelBackgroundColor=#161b22;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=1;entryY=0.8;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="260" y="270"/><mxPoint x="260" y="136"/></Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
